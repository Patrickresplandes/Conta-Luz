# =============================================================
# Controle de Energia — variáveis de ambiente
#
# Copie este arquivo para ".env.local" e preencha.
# NUNCA versionar o .env.local (já está no .gitignore).
# =============================================================

# -------------------------------------------------------------
# SEM ESTE ARQUIVO: MODO DEMONSTRAÇÃO
#
# Se as variáveis NEXT_PUBLIC_FIREBASE_* ficarem vazias, o app
# NÃO QUEBRA — ele entra em modo demonstração:
#
#   • o acesso por e-mail aceita qualquer e-mail e qualquer senha
#     com 8 caracteres ou mais;
#   • a API responde com o histórico real da fatura 09/2026
#     (13 meses), calculado pelo mesmo motor do app de verdade;
#   • o que for salvo fica em memória, só nesta aba do navegador.
#
# Isso acontece TODO no cliente: o servidor continua exigindo
# token do Firebase e continua gravando no Firestore de verdade.
# Basta preencher as variáveis abaixo para o app voltar ao caminho
# real, sem trocar uma linha de código.
# -------------------------------------------------------------

# -------------------------------------------------------------
# Firebase — lado do CLIENTE (expostas ao navegador por nature)
#
# A API key NÃO é um segredo: ela identifica o projeto, não dá
# acesso. Quem protege os dados são as Firestore Security Rules e
# a verificação de token no servidor.
#
# Mesmo assim, no Console do Firebase → Authentication → Settings →
# Authorized domains, RESTRINJA o domínio de produção. E ative o
# App Check (reCAPTCHA) para exigir que a chamada venha do app.
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -------------------------------------------------------------
# Firebase Admin — lado do SERVIDOR (NUNCA exponha com NEXT_PUBLIC_)
#
# 1. Firebase Console → Project Settings → Service Accounts
# 2. "Generate new private key" → baixa um .json
# 3. Cole os valores aqui. A private key precisa das \n trocadas
#    por "\\n" se colar em uma única linha.
#
# Alternativa sem chave de serviço: em ambientes do Google Cloud
# (Cloud Run, App Engine, Cloud Functions), omita tudo isto — o SDK
# usa as credenciais padrão da plataforma automaticamente.
# -------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# -------------------------------------------------------------
# URLs autorizadas para Server Actions (CSRF)
# Liste os domínios exatos, separados por vírgula.
# -------------------------------------------------------------
NEXT_PUBLIC_ORIGINS=http://localhost:3000

# -------------------------------------------------------------
# NUNCA defina estas variáveis NEXT_PUBLIC_*:
#   FIREBASE_ADMIN_*  (credenciais do servidor)
#   qualquer segredo de API
# Se aparecerem com prefixo NEXT_PUBLIC_, o Next.js as injeta no
# bundle do navegador — e o bundle é público.
# -------------------------------------------------------------
